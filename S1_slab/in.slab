# ============================================================================
#  S1: a-SiO2 벌크 -> 슬랩 (z 진공 추가, boundary p p f)
# ============================================================================
#  입력 : ../init_struct/sio2_quenched.data  (2160 atoms, Si 720 / O 1440,
#                                             rho = 2.607 g/cc, 박스 28.73 x 28.83 x 33.27)
#  출력 : slab_raw.data        <- S2(표면 이완)의 입력
#         zprof_*_raw.dat      <- S2 전후 비교용 z-밀도 프로파일 baseline
#         slab_raw.lammpstrj
#
#  실행 : lmp_serial -in in.slab -log log.slab
#
#  동역학 없음. 목적:
#   (A) 절단 전 주기 상태 에너지 E_bulk 기록
#   (B) 절단 후 에너지 E_slab -> gamma_unrelaxed = (E_slab - E_bulk)/2A
#       (S4 의 W_adh 와 완전히 같은 계산 방식이라 미리 검증하는 의미)
#   (C) PPPM slab 설정이 뜨는지, 원자 손실 0 인지, 배위수/Pzz 가 예상대로인지
# ============================================================================

# ---------------- 1. Init ----------------
units           metal
boundary        p p p              # 원본 데이터는 전 방향 주기이므로 그대로 읽는다
atom_style      charge

read_data       ../init_struct/sio2_quenched.data

mass            1 15.9994          # O
mass            2 28.0855          # Si
# 전하는 data 파일에 이미 들어있다 (O -1.2 / Si +2.4). set 으로 재지정하지 않는다.

# ---------------- 2. Force field ----------------
#  melt-quench 와 완전히 동일. (kspace_modify slab 은 여기 없음 -- 아래 3-B 에서 선언)
include         ../common/ff_sio2.in

# ---------------- 3. 진단량 ----------------
group           gO   type 1
group           gSi  type 2

compute         cnSi all coord/atom cutoff 2.0 1     # 각 원자 주변 O  개수
compute         cnO  all coord/atom cutoff 2.0 2     # 각 원자 주변 Si 개수
compute         avgSi gSi reduce ave c_cnSi          # <CN(Si-O)>
compute         avgO  gO  reduce ave c_cnO           # <CN(O-Si)>
variable        pea equal pe/atoms

thermo_style    custom step atoms pe v_pea press pxx pyy pzz vol c_avgSi c_avgO
thermo          1

# ---------------- 3-A. 절단 전 (주기) 기준 상태 ----------------
print           "=========== A: bulk periodic reference ==========="
run             0
#  [중요] $(...) 로 즉시 평가해 상수로 고정한다.
#  'variable X equal pe' 로 쓰면 지연 평가라서 나중에 참조할 때 '현재' pe 가 나온다.
variable        Ebulk  equal $(pe)
variable        CNbulk equal $(c_avgSi)
variable        Abox   equal $(lx*ly)      # 표면 1개의 면적 [A^2]

# ---------------- 3-B. 진공 추가 + z 비주기화 ----------------
#  [순서 중요] (a) 먼저 z 를 늘리고 (b) 그 다음 boundary 를 f 로.
#   반대로 하면 zhi(34.087) 경계에 걸친 원자가 lost 될 수 있다.
#  [remap 금지] remap 을 쓰면 좌표가 박스와 함께 스케일링되어 슬랩 자체가 늘어난다.
#   원자는 z=0.82~34.09 에 그대로 두고 박스만 위로 연다 -> 기존 z 주기경계면이
#   그대로 절단면이 되어 상/하 두 개의 표면이 생긴다. 하단은 S2 에서 고정.
#  [z=120 A 근거] slab-slab 이미지 간격 = 3*Lz - 두께 = 360 - 54 = 306 A 로 충분.
#   실제 제약은 정전기가 아니라 기하학:
#     0~34 슬랩 / ~34~65 Cu / 90~95 S5 증착원 삽입영역 / 118 S5 상단 반사벽
change_box      all z final 0.0 120.0 units box
change_box      all boundary p p f
set             group all image NULL NULL 0

#  [슬랩 전용] boundary p p f 로 바꾼 직후에 선언. volfactor 3.0 은 LAMMPS 권장값
#  (더 크면 비효율, 더 작으면 slab-slab 상호작용 잔존).
#  Yeh & Berkowitz, J Chem Phys 111, 3155 (1999)
kspace_modify   slab 3.0

print           "=========== B: slab (cut, unrelaxed) ==========="
run             0
variable        Eslab  equal $(pe)

# ---------------- 4. 미이완 표면에너지 ----------------
#  절단으로 표면이 2개 생기므로 2A 로 나눈다. 1 eV/A^2 = 16.0217663 J/m^2
variable        gam0   equal (${Eslab}-${Ebulk})/(2*${Abox})
variable        gam0J  equal ${gam0}*16.0217663
print           "-------------------------------------------------"
print           "E_bulk (periodic)   = ${Ebulk} eV"
print           "E_slab (cut)        = ${Eslab} eV"
print           "cleavage energy     = $(v_Eslab-v_Ebulk) eV"
print           "surface area A      = ${Abox} A^2  (표면 1개)"
print           "gamma_unrelaxed     = ${gam0} eV/A^2 = ${gam0J} J/m^2"
print           "<CN(Si-O)> bulk     = ${CNbulk}"
print           "-------------------------------------------------"
#  [정확도 주의] PPPM accuracy 1e-4 는 상대값이라 총에너지 -41039 eV 에 대해
#  절대오차가 ~4 eV 수준. cleavage energy(수백 eV)에는 충분하지만,
#  S4 의 W_adh 는 큰 값들의 작은 차이라 그때는 pppm 1e-5~1e-6 으로 조일 것.

# ---------------- 5. z-밀도 프로파일 (S2 비교 baseline) ----------------
#  [주의] fix ave/chunk 는 chunk compute ID 를 접두사 없이 받는다 (c_chO 아님).
#  [주의] run 0 은 end_of_step 을 호출하지 않아 파일이 안 써진다 -> run 1.
#         적분 fix 가 없으므로 원자는 움직이지 않는다.
compute         chO  gO  chunk/atom bin/1d z lower 0.5 units box
compute         chSi gSi chunk/atom bin/1d z lower 0.5 units box
fix             pO  gO  ave/chunk 1 1 1 chO  density/mass file zprof_O_raw.dat
fix             pSi gSi ave/chunk 1 1 1 chSi density/mass file zprof_Si_raw.dat
run             1
unfix           pO
unfix           pSi

# ---------------- 6. 출력 ----------------
write_data      slab_raw.data
write_dump      all atom slab_raw.lammpstrj
