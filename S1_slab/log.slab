variable        Eslab  equal $(pe)
variable        Eslab  equal -41038.959395193356613

# ---------------- 4. 미이완 표면에너지 ----------------
#  절단으로 표면이 2개 생기므로 2A 로 나눈다. 1 eV/A^2 = 16.0217663 J/m^2
variable        gam0   equal (${Eslab}-${Ebulk})/(2*${Abox})
variable        gam0   equal (-41038.9593951934-${Ebulk})/(2*${Abox})
variable        gam0   equal (-41038.9593951934--41686.444024859)/(2*${Abox})
variable        gam0   equal (-41038.9593951934--41686.444024859)/(2*828.198566778822)
variable        gam0J  equal ${gam0}*16.0217663
variable        gam0J  equal 0.390899390338187*16.0217663
print           "-------------------------------------------------"
-------------------------------------------------
print           "E_bulk (periodic)   = ${Ebulk} eV"
E_bulk (periodic)   = -41686.444024859 eV
print           "E_slab (cut)        = ${Eslab} eV"
E_slab (cut)        = -41038.9593951934 eV
print           "cleavage energy     = $(v_Eslab-v_Ebulk) eV"
cleavage energy     = 647.48462966560327914 eV
print           "surface area A      = ${Abox} A^2  (표면 1개)"
WARNING: Detected non-ASCII characters in input. Will try to continue by replacing with ASCII equivalents where known. (src/input.cpp:436)
surface area A      = 828.198566778822 A^2  (���� 1��)
print           "gamma_unrelaxed     = ${gam0} eV/A^2 = ${gam0J} J/m^2"
gamma_unrelaxed     = 0.390899390338187 eV/A^2 = 6.26289867881091 J/m^2
print           "<CN(Si-O)> bulk     = ${CNbulk}"
<CN(Si-O)> bulk     = 4.01666666666667
print           "-------------------------------------------------"
-------------------------------------------------
#  [정확도 주의] PPPM accuracy 1e-4 는 상대값이라 총에너지 -41039 eV 에 대해
#  절대오차가 ~4 eV 수준. cleavage energy(수백 eV)에는 충분하지만,
#  S4 의 W_adh 는 큰 값들의 작은 차이라 그때는 pppm 1e-5~1e-6 으로 조일 것.

# ---------------- 5. z-밀도 프로파일 (S2 비교 baseline) ----------------
#  [주의] fix ave/chunk 는 chunk compute ID 를 접두사 없이 받는다 (c_chO 아님).
#  [주의] run 0 은 end_of_step 을 호출하지 않아 파일이 안 써진다 -> run 1.
#         적분 fix 가 없으므로 원자는 움직이지 않는다.
compute         chO  gO  chunk/atom bin/1d z lower 0.5 units box
compute         chSi gSi chunk/atom bin/1d z lower 0.5 units box
fix             pO  gO  ave/chunk 1 1 1 chO  density/mass file zprof_O_raw.dat
fix             pSi gSi ave/chunk 1 1 1 chSi density/mass file zprof_Si_raw.dat
run             1
