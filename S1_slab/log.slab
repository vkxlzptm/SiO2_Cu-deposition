LAMMPS (23 Jun 2022 - Update 1)
# ============================================================================
#  S1: a-SiO2 벌크 -> 슬랩 (z 진공 추가, boundary p p f)
# ============================================================================
#  입력 : ../init_struct/sio2_quenched.data  (2160 atoms, Si 720 / O 1440,
#                                             rho = 2.607 g/cc, 박스 28.73 x 28.83 x 33.27)
#  출력 : slab_raw.data     <- S2(표면 이완)의 입력
#         zprof_*_raw.dat   <- S2 전후 비교용 z-밀도 프로파일 baseline
#         slab_raw.lammpstrj
#
#  실행 : lmp_serial -in in.slab -log log.slab
#
#  이 단계는 동역학을 돌리지 않는다(run 0). 목적은 세 가지뿐:
#   (1) PPPM slab 설정이 에러 없이 뜨는지
#   (2) 절단 직후 PE / 배위수 / pzz 를 기록해 S2 이완의 '전(before)' 기준을 확보
#   (3) 원자 손실 0 확인
# ============================================================================

# ---------------- 1. Init ----------------
units           metal
boundary        p p p              # 원본 데이터는 전 방향 주기이므로 그대로 읽는다
atom_style      charge

read_data       ../init_struct/sio2_quenched.data
Reading data file ...
  orthogonal box = (0.70531404 0.70777887 0.81682301) to (29.433599 29.53646 34.087002)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  2160 atoms
  reading velocities ...
  2160 velocities
  read_data CPU = 0.009 seconds

mass            1 15.9994          # O
mass            2 28.0855          # Si
# 전하는 data 파일에 이미 들어있다 (O -1.2 / Si +2.4). set 으로 재지정하지 않는다.

# ---------------- 2. 진공 추가 + z 비주기화 ----------------
#  [순서 중요] (a) 먼저 z 를 늘리고 (b) 그 다음 boundary 를 f 로 바꾼다.
#   반대로 하면 zhi(34.087) 경계에 걸친 원자가 lost 될 수 있다.
#
#  [remap 금지] remap 을 쓰면 좌표가 박스와 함께 스케일링되어 슬랩 자체가
#   z 방향으로 3.6배 늘어난다. 절대 쓰지 말 것. 원자는 z=0.82~34.09 에 그대로 두고
#   박스만 위로 연다 -> 기존 z 주기경계면이 그대로 절단면이 되어
#   상(z~34.09) / 하(z~0.82) 두 개의 표면이 생긴다. 하단은 S2 에서 고정한다.
#
#  [z=120 A 근거] slab-slab 이미지 간격 = 3*Lz - 두께 = 360 - 54 = 306 A 로 충분.
#   실제 제약은 정전기가 아니라 기하학이다:
#     0~34    SiO2 슬랩
#     ~34~65  Cu (섬 성장 최악 시나리오 포함)
#     90~95   S5 의 fix deposit 삽입 영역 (막 상단과 25 A 이상 이격)
#     118     S5 의 상단 반사벽
change_box      all z final 0.0 120.0 units box
Changing box ...
  orthogonal box = (0.70531404 0.70777887 0) to (29.433599 29.53646 120)
change_box      all boundary p p f
Changing box ...
WARNING: Resetting image flags for non-periodic dimensions (src/domain.cpp:1928)

# z 이미지플래그 초기화 (이후 MSD/unwrap 분석에서 z 방향 오염 방지)
set             group all image NULL NULL 0
Setting atom values ...
  2160 settings made for image

# ---------------- 3. Force field ----------------
#  melt-quench 와 완전히 동일. kspace_modify slab 3.0 도 이 안에 있다.
include         ../common/ff_sio2.in
# ============================================================================
#  common/ff_sio2.in  --  a-SiO2 슬랩용 힘장 정의 (S1, S2 전용)
# ============================================================================
#  melt-quench 입력(in.sio2 v7)과 파라미터가 완전히 동일해야 한다.
#  이 프로젝트의 모든 결론은 '조건 간 상대 비교'이므로, 단계마다 힘장이
#  미묘하게 달라지면 비교 자체가 무의미해진다. 그래서 한 곳에서만 관리한다.
#
#  type 1 = O  (q = -1.2)
#  type 2 = Si (q = +2.4)
#
#  [중요] 이 파일은 pair_style 을 '선언'한다. LAMMPS 에서 pair_style 재선언은
#  기존 pair_coeff 를 전부 삭제하므로, Cu(type 3)를 추가하는 S3 이후 단계는
#  이 파일을 include 하지 말고 common/ff_full.in 을 쓸 것.
#
#  [BKS 출처] van Beest, Kramer, van Santen, PRL 64, 1955 (1990)
#  [overlay 안전망] Buckingham catastrophe(r->0 에서 -C/r^6 발산) 대응.
#    ZBL(~r^-1)은 r^-6 을 이길 수 없어 무효 -> r^-12 LJ 로 교체.
#    cutoff 를 BKS 자체 반발 시작점(O-O 1.50 A, Si-O 1.10 A)에 맞춰
#    WCA 형으로 두어 힘 불연속을 최소화. 0.05~3.0 A 전 구간 단조반발 검증 완료.
# ============================================================================

pair_style      hybrid/overlay buck/coul/long 10.0 lj/cut 1.5

# --- BKS Buckingham + Ewald 실공간 (A[eV], rho[A], C[eV*A^6]) ---
pair_coeff      1 1 buck/coul/long  1388.7730  0.362318  175.0000   # O-O
pair_coeff      1 2 buck/coul/long 18003.7572  0.205205  133.5381   # Si-O
pair_coeff      2 2 buck/coul/long     0.0     1.0         0.0      # Si-Si (A=0)

# --- r^-12 반발 안전망 (eps[eV], sigma[A], cutoff=sigma -> WCA) ---
pair_coeff      1 1 lj/cut  3.0  1.50  1.50    # O-O
pair_coeff      1 2 lj/cut  4.0  1.10  1.10    # Si-O
pair_coeff      2 2 lj/cut  0.0  1.0   1.0     # Si-Si (BKS A=0 이라 위험 없음)

# --- 장거리 정전기 ---
#  10 A cutoff 유지: 이 값에서 BKS 는 유리 밀도를 과대평가(본 구조 2.607 vs
#  실험 2.20 g/cc)하지만, 5.5 A 로 줄이면 탄성물성이 틀어진다. 계면 역학이
#  핵심인 본 과제에서는 10 A 를 유지하고 결론은 상대 비교로만 해석한다.
kspace_style    pppm 1.0e-4

#  [슬랩 전용] boundary p p f 필수. volfactor 3.0 은 LAMMPS 권장값
#  (더 크면 비효율, 더 작으면 slab-slab 상호작용 잔존).
#  Yeh & Berkowitz, J Chem Phys 111, 3155 (1999)
kspace_modify   slab 3.0

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# ---------------- 4. 검증용 진단량 ----------------
group           gO   type 1
1440 atoms in group gO
group           gSi  type 2
720 atoms in group gSi

compute         cnSi all coord/atom cutoff 2.0 1     # 각 원자 주변 O  개수
compute         cnO  all coord/atom cutoff 2.0 2     # 각 원자 주변 Si 개수
compute         avgSi gSi reduce ave c_cnSi          # <CN(Si-O)>  벌크값 4.017
compute         avgO  gO  reduce ave c_cnO           # <CN(O-Si)>  벌크값 2.008
variable        pea equal pe/atoms

thermo_style    custom step atoms pe v_pea press pxx pyy pzz vol c_avgSi c_avgO
thermo          1
run             0
WARNING: No fixes with time integration, atoms won't move (src/verlet.cpp:60)
